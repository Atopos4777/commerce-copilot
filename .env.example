# 运行模式：mock（纯演示，不调模型）/ live（强制真实模型）/ auto（默认，需同时配置 BASE_URL 才走真实）
AI_MODE=auto

# OpenAI 兼容接口配置（DeepSeek、通义、自建中转等都可以）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 生图模型：走同一个 BASE_URL 的 /images/generations（OpenAI 兼容）
# gpt-image-1 / dall-e-3 / 中转平台的 sd 模型都可以
IMAGE_MODEL=gpt-image-1
# 未配置 Key 时自动使用免费图像通道（Pollinations），设为 off 可关闭
IMAGE_FREE_FALLBACK=on
# 免费通道模型：turbo 快（约 5-10 秒），flux 质量更好但更慢
IMAGE_FREE_MODEL=turbo

# 魔搭 API-Inference（每日免费额度，支持图生图）：modelscope.cn → 账号设置 → 访问令牌
# 配置后生图/图生图优先走魔搭，额度用完再回落到上面的模型或免费通道
MODELSCOPE_TOKEN=
MODELSCOPE_IMAGE_MODEL=Qwen/Qwen-Image-Edit-2509
